# ==============================================================================
# NeoBharat — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and populate with your credentials.
# NEVER commit real credentials to version control.
# Both OpenAI and Firebase integrations automatically fall back to deterministic
# local mock engines if credentials are omitted.

# ------------------------------------------------------------------------------
# Flask Backend Server
# ------------------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# ------------------------------------------------------------------------------
# Groq LLM Explanation Layer (Primary HackOut'26 Runtime)
# ------------------------------------------------------------------------------
# Server-side only. Never expose this key in client-side code or browser bundles.
# Uses Groq's high-speed OpenAI-compatible API (https://api.groq.com/openai/v1).
# If omitted, NeoBharat automatically activates its deterministic fallback engine.
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional fallback provider (OpenAI)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Firebase Firestore Cloud Persistence (Phase 8)
# ------------------------------------------------------------------------------
# Used for appointment bookings, multi-turn conversation memory, and audit trails.
# If omitted or unconfigured, NeoBharat automatically falls back to an in-memory
# thread-safe MockFirestoreClient with identical collection/document semantics.
FIREBASE_PROJECT_ID=neobharat-prototype
FIREBASE_SERVICE_ACCOUNT_KEY=config/serviceAccountKey.json

# ------------------------------------------------------------------------------
# Frontend Vite Configuration
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000
